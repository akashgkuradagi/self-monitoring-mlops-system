# Self-Monitoring MLOps System Configuration Template (.env.example)
# Copy this file to .env and configure for your local/deployment environment.

# Service Settings
APP_NAME=Self-Monitoring MLOps System
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security & Authentication Settings (SEC-01, SR-01, SR-02)
# NEVER commit production secret keys to version control.
# Generate a cryptographically secure random key: openssl rand -hex 32
JWT_SECRET_KEY=change-this-insecure-default-key-to-a-32-byte-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Configured API Keys for automated service authentication (format: key:Role, comma-separated)
# Allowed roles: Viewer, ML_Engineer, Administrator
API_KEYS=test-viewer-key:Viewer,test-engineer-key:ML_Engineer,test-admin-key:Administrator

# CORS Security Configuration (SR-06)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Telemetry and Buffer Limits (SR-04, NFR-12)
ROLLING_WINDOW_SIZE=1000
MAX_REQUEST_SIZE_BYTES=1048576

# Audit Storage Settings (SEC-02, FR-11, SR-05)
AUDIT_DB_PATH=telemetry.db

# MLflow Tracking & Model Registry Settings (ML-01, FR-04, NFR-04)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=production-tabular-monitoring
MLFLOW_MODEL_NAME=ProductionClassifier
MODEL_RANDOM_SEED=42

# Statistical Drift Monitoring Settings (MON-01, FR-03, FR-08)
DRIFT_KS_ALPHA=0.05
DRIFT_PSI_THRESHOLD=0.25
DRIFT_PSI_MODERATE_THRESHOLD=0.10
DRIFT_MIN_SAMPLE_SIZE=50
DRIFT_REFERENCE_PATH=data/reference/reference.csv
DRIFT_NUM_BINS=10

# Multi-Metric Alerting Settings (ALERT-01, FR-08, NFR-07)
ALERTS_DB_PATH=telemetry.db
ALERT_DEDUP_WINDOW_SECONDS=300
ALERT_ERROR_RATE_THRESHOLD=0.05
ALERT_LATENCY_P95_THRESHOLD_MS=500.0
ALERT_LATENCY_P95_WARNING_MS=300.0
